<h1>Learn Haskell</h1>

<h2>My tutorials</h2>
<table class="site-table fixed-table">
  {{# my_tutorials }}
  <tr>
    <td class="whitespace-nowrap text-neutral-500">{{ published }}</td>
    <td>
      {{# url }}
      <a href="{{ . }}" target="_blank" rel="noopener noreferrer">{{ title }}</a>
      {{> icon-external-link }}
      {{/ url }}
      {{^ url }}
      <a href="{{ page }}">{{ title }}</a>
      {{/ url }}
    </td>
  </tr>
  {{/ my_tutorials }}
</table>

<h2>Recommended tutorials</h2>
<table class="site-table fixed-table">
  {{# recommended_tutorials }}
  <tr>
    <td>{{ topic }}</td>
    <td>
      <a href="{{ url }}" target="_blank" rel="noopener noreferrer">{{ title }}</a>
      {{> icon-external-link }}
    </td>
  </tr>
  {{/ recommended_tutorials }}
</table>
